{
	"name": "codevibe",
	"displayName": "Codie",
	"description": "Codie is an editor-native VS Code-based AI IDE agent with Codie sign-in, model-source choices, planning, tools, MCP, browser automation, and background workflows.",
	"version": "3.88.77",
	"icon": "assets/icons/icon.png",
	"engines": {
		"vscode": "^1.84.0"
	},
	"enabledApiProposals": [
		"chatParticipantAdditions",
		"chatPromptFiles",
		"defaultChatParticipant",
		"chatSessionCustomizationProvider",
		"chatSessionsProvider",
		"findTextInFiles"
	],
	"author": {
		"name": "Codie"
	},
	"license": "Apache-2.0",
	"publisher": "atnumridha",
	"repository": {
		"type": "git",
		"url": "https://github.com/atnumridha/codevibe"
	},
	"homepage": "https://github.com/atnumridha/codevibe",
	"categories": [
		"AI",
		"Chat",
		"Programming Languages",
		"Education",
		"Snippets",
		"Testing"
	],
	"keywords": [
		"codie",
		"codevibe",
		"mcp",
		"openrouter",
		"coding",
		"agent",
		"autonomous",
		"chatgpt",
		"sonnet",
		"ai",
		"llama"
	],
	"activationEvents": [
		"onLanguage",
		"onUri",
		"onCommand:cursor.ndjsonIngest.start",
		"onCommand:cursor.ndjsonIngest.stop",
		"onCommand:cursor.ndjsonIngest.copyCurl",
		"onCommand:cursor.ndjsonIngest.reassignPort",
		"onCommand:cursor.ndjsonIngest.showStatus",
		"onCommand:cursor-deeplink.debug.triggerDeeplink",
		"onCommand:codevibe.compatibility.ndjson.start",
		"onCommand:codevibe.compatibility.ndjson.stop",
		"onCommand:codevibe.compatibility.ndjson.copyCurl",
		"onCommand:codevibe.compatibility.ndjson.reassignPort",
		"onCommand:codevibe.compatibility.ndjson.showStatus",
		"onCommand:codevibe.compatibility.deeplink.debug.trigger",
		"onStartupFinished",
		"workspaceContains:evals.env",
		"onCommand:codevibe.plusButtonClicked",
		"onCommand:codevibe.mcpButtonClicked",
		"onCommand:codevibe.historyButtonClicked",
		"onCommand:codevibe.accountButtonClicked",
		"onCommand:codevibe.worktreesButtonClicked",
		"onCommand:codevibe.settingsButtonClicked",
		"onCommand:codevibe.nativeAgentDiagnostics",
		"onCommand:codevibe.newNativeAgentSession",
		"onCommand:codevibe.plans.refresh",
		"onCommand:codevibe.plans.open",
		"onCommand:codevibe.plans.openLatest",
		"onCommand:codevibe.plans.openFolder",
		"onCommand:codevibe.plans.buildLocal",
		"onCommand:codevibe.plans.buildParallel",
		"onCustomEditor:codevibe.planEditor",
		"onCommand:codevibe.dev.createTestTasks",
		"onCommand:codevibe.dev.expireMcpOAuthTokens",
		"onCommand:codevibe.addToChat",
		"onCommand:codevibe.addTerminalOutputToChat",
		"onCommand:codevibe.focusChatInput",
		"onCommand:codevibe.openLegacyWebview",
		"onCommand:codevibe.fixWithCodeVibe",
		"onCommand:codevibe.generateGitCommitMessage",
		"onCommand:codevibe.abortGitCommitMessage",
		"onCommand:codevibe.explainCode",
		"onCommand:codevibe.improveCode",
		"onCommand:codevibe.jupyterGenerateCell",
		"onCommand:codevibe.jupyterExplainCell",
		"onCommand:codevibe.jupyterImproveCell",
		"onCommand:codevibe.openWalkthrough",
		"onCommand:codevibe.reconstructTaskHistory",
		"onCommand:codevibe.reviewComment.reply",
		"onCommand:codevibe.reviewComment.addToChat",
		"onChatParticipant:codevibe",
		"onChatParticipant:codevibe-agent",
		"onChatSession:codevibe-agent",
		"onView:codevibe-agent-chat"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"icons": {
			"codevibe-icon": {
				"description": "Codie",
				"default": {
					"fontPath": "assets/icons/codevibe-glyph.woff",
					"fontCharacter": "\\e900"
				}
			}
		},
		"walkthroughs": [
			{
				"id": "CodeVibeWalkthrough",
				"title": "Meet Codie, your new coding partner",
				"description": "Codie codes like a developer because it thinks like one. Here are 5 ways to put it to work:",
				"steps": [
					{
						"id": "welcome",
						"title": "Start with a Goal, Not Just a Prompt",
						"description": "Tell Codie what you want to achieve. It plans, asks, and then codes, like a true partner.",
						"media": {
							"markdown": "walkthrough/step1.md"
						}
					},
					{
						"id": "learn",
						"title": "Let Codie Learn Your Codebase",
						"description": "Point Codie to your project. It builds understanding to make smart, context-aware changes.",
						"media": {
							"markdown": "walkthrough/step2.md"
						}
					},
					{
						"id": "advanced-features",
						"title": "Choose Your Model Source",
						"description": "Codie connects to Codie sign-in, your own model keys, local runtimes, and compatible gateways from one model picker.",
						"media": {
							"markdown": "walkthrough/step3.md"
						}
					},
					{
						"id": "mcp",
						"title": "Extend with Powerful Tools (MCP)",
						"description": "Connect to databases, APIs, or discover new capabilities in the MCP catalog.",
						"media": {
							"markdown": "walkthrough/step4.md"
						}
					},
					{
						"id": "getting-started",
						"title": "You're Always in Control",
						"description": "Review Codie's plans and diffs. Approve changes before they happen. No surprises.",
						"media": {
							"markdown": "walkthrough/step5.md"
						},
						"content": {
							"path": "walkthrough/step5.md"
						}
					}
				]
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "codevibe-agent",
					"title": "Codie Agent",
					"icon": "assets/icons/activitybar.svg"
				}
			]
		},
		"views": {
			"codevibe-agent": [
				{
					"id": "codevibe-agent-chat",
					"name": "Compatibility Timeline",
					"type": "webview",
					"icon": "assets/icons/activitybar.svg",
					"visibility": "hidden"
				},
				{
					"id": "codevibe-agent-plans",
					"name": "Plans",
					"icon": "assets/icons/activitybar.svg"
				}
			]
		},
		"customEditors": [
			{
				"viewType": "codevibe.planEditor",
				"displayName": "Codie Plan",
				"selector": [
					{
						"filenamePattern": "*.plan.md"
					}
				],
				"priority": "default"
			}
		],
		"configurationDefaults": {
			"workbench.editorAssociations": {
				"*.plan.md": "codevibe.planEditor"
			}
		},
		"chatAgents": [
			{
				"id": "codevibe-agent",
				"name": "codie",
				"description": "Use Codie Agent for planning, coding, reviews, diffs, terminal approvals, MCP, browser automation, and Codie sign-in.",
				"path": "agents/00-codevibe-agent.agent.md"
			}
		],
		"chatSessions": [
			{
				"id": "codevibe-agent",
				"type": "codevibe-agent",
				"name": "Codie Agent",
				"displayName": "Codie Agent",
				"icon": "$(codevibe-icon)",
				"welcomeTitle": "Codie Agent",
				"welcomeMessage": "Plan, edit, review, run tools, apply diffs, use terminal approvals, MCP, browser automation, and Codie sign-in.",
				"inputPlaceholder": "Ask Codie to build, fix, review, or plan",
				"order": -1000,
				"canDelegate": true,
				"description": "Use Codie Agent for local coding workflows",
				"capabilities": {
					"supportsFileAttachments": true,
					"supportsProblemAttachments": true,
					"supportsImageAttachments": true,
					"supportsSymbolAttachments": true,
					"supportsSearchResultAttachments": true,
					"supportsSourceControlAttachments": true,
					"supportsPromptAttachments": true,
					"supportsHandOffs": true
				},
				"commands": [
					{
						"name": "plan",
						"description": "Explore the codebase and prepare an implementation plan"
					},
					{
						"name": "act",
						"description": "Start an implementation task in Codie"
					},
					{
						"name": "review",
						"description": "Review the current code or selected changes"
					}
				],
				"autoAttachReferences": true,
				"useRequestToPopulateBuiltInPickers": true
			}
		],
		"chatParticipants": [
			{
				"id": "codevibe",
				"name": "codevibe",
				"fullName": "Codie Agent",
				"description": "Plan, edit, review, run tools, and work across this repository",
				"isSticky": true,
				"isDefault": true,
				"locations": [
					"panel"
				],
				"modes": [
					"agent"
				],
				"commands": [
					{
						"name": "plan",
						"description": "Explore the codebase and prepare an implementation plan"
					},
					{
						"name": "act",
						"description": "Start an implementation task in Codie"
					},
					{
						"name": "review",
						"description": "Review the current code or selected changes"
					}
				]
			},
			{
				"id": "codevibe-agent",
				"name": "codie-agent",
				"fullName": "Codie Agent",
				"description": "Route native Codie Agent sessions into Codie",
				"locations": [
					"panel"
				],
				"modes": [
					"agent"
				],
				"commands": [
					{
						"name": "plan",
						"description": "Explore the codebase and prepare an implementation plan"
					},
					{
						"name": "act",
						"description": "Start an implementation task in Codie"
					},
					{
						"name": "review",
						"description": "Review the current code or selected changes"
					}
				]
			}
		],
		"chatPromptFiles": [
			{
				"path": "./assets/prompts/codevibe-plan.prompt.md",
				"sessionTypes": [
					"codevibe-agent"
				]
			},
			{
				"path": "./assets/prompts/codevibe-review.prompt.md",
				"sessionTypes": [
					"codevibe-agent"
				]
			},
			{
				"path": "./assets/prompts/codevibe-standalone-readiness.prompt.md",
				"sessionTypes": [
					"codevibe-agent"
				]
			}
		],
		"chatSkills": [
			{
				"path": "./assets/prompts/skills/codevibe-customizations/SKILL.md",
				"sessionTypes": [
					"codevibe-agent"
				]
			},
			{
				"path": "./assets/prompts/skills/codevibe-cursor-compatibility/SKILL.md",
				"sessionTypes": [
					"codevibe-agent"
				]
			},
			{
				"path": "./assets/prompts/skills/codevibe-local-plan-build/SKILL.md",
				"sessionTypes": [
					"codevibe-agent"
				]
			},
			{
				"path": "./assets/prompts/skills/codevibe-mcp/SKILL.md",
				"sessionTypes": [
					"codevibe-agent"
				]
			},
			{
				"path": "./assets/prompts/skills/codevibe-background-sessions/SKILL.md",
				"sessionTypes": [
					"codevibe-agent"
				]
			},
			{
				"path": "./assets/prompts/skills/codevibe-release-validation/SKILL.md",
				"sessionTypes": [
					"codevibe-agent"
				]
			},
			{
				"path": "./assets/prompts/skills/codevibe-performance-troubleshooting/SKILL.md",
				"sessionTypes": [
					"codevibe-agent"
				]
			}
		],
		"commands": [
			{
				"command": "codevibe.plusButtonClicked",
				"title": "New Task",
				"category": "Codie",
				"icon": "$(add)"
			},
			{
				"command": "codevibe.mcpButtonClicked",
				"title": "MCP Servers",
				"category": "Codie",
				"icon": "$(server)"
			},
			{
				"command": "codevibe.historyButtonClicked",
				"title": "History",
				"category": "Codie",
				"icon": "$(history)"
			},
			{
				"command": "codevibe.accountButtonClicked",
				"title": "Account",
				"category": "Codie",
				"icon": "$(account)"
			},
			{
				"command": "codevibe.worktreesButtonClicked",
				"title": "Open Codie Worktrees",
				"category": "Codie",
				"icon": "$(git-branch)"
			},
			{
				"command": "codevibe.settingsButtonClicked",
				"title": "Settings",
				"category": "Codie",
				"icon": "$(settings-gear)"
			},
			{
				"command": "codevibe.nativeAgentDiagnostics",
				"title": "Show Native Agent Diagnostics",
				"category": "Codie",
				"icon": "$(pulse)"
			},
			{
				"command": "codevibe.newNativeAgentSession",
				"title": "New Codie Agent",
				"category": "Codie",
				"icon": "$(sparkle)"
			},
			{
				"command": "codevibe.plans.refresh",
				"title": "Refresh Plans",
				"category": "Codie",
				"icon": "$(refresh)"
			},
			{
				"command": "codevibe.plans.open",
				"title": "Open Plan",
				"category": "Codie",
				"icon": "$(go-to-file)"
			},
			{
				"command": "codevibe.plans.openLatest",
				"title": "Open Latest Plan",
				"category": "Codie",
				"icon": "$(preview)"
			},
			{
				"command": "codevibe.plans.openFolder",
				"title": "Reveal Local Plans Folder",
				"category": "Codie",
				"icon": "$(folder-opened)"
			},
			{
				"command": "codevibe.plans.buildLocal",
				"title": "Build Plan Locally",
				"category": "Codie",
				"icon": "$(play)"
			},
			{
				"command": "codevibe.plans.buildParallel",
				"title": "Build Plan in Parallel",
				"category": "Codie",
				"icon": "$(git-branch)"
			},
			{
				"command": "codevibe.dev.createTestTasks",
				"title": "Create Test Tasks",
				"category": "Codie",
				"when": "codevibe.isDevMode"
			},
			{
				"command": "codevibe.dev.expireMcpOAuthTokens",
				"title": "Expire MCP OAuth Tokens (for testing)",
				"category": "Codie",
				"when": "codevibe.isDevMode"
			},
			{
				"command": "codevibe.addToChat",
				"title": "Add to Codie",
				"category": "Codie"
			},
			{
				"command": "codevibe.addTerminalOutputToChat",
				"title": "Add to Codie",
				"category": "Codie"
			},
			{
				"command": "codevibe.focusChatInput",
				"title": "Open Codie",
				"category": "Codie"
			},
			{
				"command": "codevibe.openLegacyWebview",
				"title": "Show Codie Compatibility Panel",
				"category": "Codie"
			},
			{
				"command": "codevibe.fixWithCodeVibe",
				"title": "Fix with Codie",
				"category": "Codie",
				"icon": "$(codevibe-icon)"
			},
			{
				"command": "codevibe.generateGitCommitMessage",
				"title": "Generate Commit Message with Codie",
				"category": "Codie",
				"icon": "$(codevibe-icon)"
			},
			{
				"command": "codevibe.abortGitCommitMessage",
				"title": "Generate Commit Message with Codie - Stop",
				"category": "Codie",
				"icon": "$(debug-stop)"
			},
			{
				"command": "codevibe.explainCode",
				"title": "Explain with Codie",
				"category": "Codie"
			},
			{
				"command": "codevibe.improveCode",
				"title": "Improve with Codie",
				"category": "Codie"
			},
			{
				"command": "codevibe.jupyterGenerateCell",
				"title": "Generate Jupyter Cell with Codie",
				"category": "Codie",
				"icon": "$(sparkle)"
			},
			{
				"command": "codevibe.jupyterExplainCell",
				"title": "Explain Jupyter Cell with Codie",
				"category": "Codie",
				"icon": "$(question)"
			},
			{
				"command": "codevibe.jupyterImproveCell",
				"title": "Improve Jupyter Cell with Codie",
				"category": "Codie",
				"icon": "$(lightbulb)"
			},
			{
				"command": "codevibe.openWalkthrough",
				"title": "Open Walkthrough",
				"category": "Codie"
			},
			{
				"command": "codevibe.reconstructTaskHistory",
				"title": "Reconstruct Task History",
				"category": "Codie"
			},
			{
				"command": "codevibe.reviewComment.reply",
				"title": "Reply",
				"category": "Codie",
				"enablement": "!commentIsEmpty"
			},
			{
				"command": "codevibe.reviewComment.addToChat",
				"title": "Add to Codie Chat",
				"category": "Codie",
				"icon": "$(link-external)"
			},
			{
				"command": "codevibe.compatibility.ndjson.start",
				"title": "Codie Compatibility NDJSON: Start Server"
			},
			{
				"command": "codevibe.compatibility.ndjson.stop",
				"title": "Codie Compatibility NDJSON: Stop Server"
			},
			{
				"command": "codevibe.compatibility.ndjson.copyCurl",
				"title": "Codie Compatibility NDJSON: Copy curl command"
			},
			{
				"command": "codevibe.compatibility.ndjson.reassignPort",
				"title": "Codie Compatibility NDJSON: Reassign port and restart server"
			},
			{
				"command": "codevibe.compatibility.ndjson.showStatus",
				"title": "Codie Compatibility NDJSON: Show server info"
			},
			{
				"command": "codevibe.compatibility.deeplink.debug.trigger",
				"title": "Debug: Trigger Arbitrary Deeplink",
				"category": "Codie Compatibility"
			}
		],
		"keybindings": [
			{
				"command": "editor.action.submitComment",
				"key": "enter",
				"when": "commentEditorFocused && commentController == codevibe-ai-review && !commentIsEmpty"
			},
			{
				"command": "codevibe.addToChat",
				"key": "cmd+'",
				"mac": "cmd+'",
				"win": "ctrl+'",
				"linux": "ctrl+'",
				"when": "editorHasSelection"
			},
			{
				"command": "codevibe.generateGitCommitMessage",
				"when": "config.git.enabled && scmProvider == git"
			},
			{
				"command": "codevibe.focusChatInput",
				"key": "cmd+'",
				"mac": "cmd+'",
				"win": "ctrl+'",
				"linux": "ctrl+'",
				"when": "!editorHasSelection"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "codevibe.plans.openLatest",
					"group": "navigation@1",
					"when": "view == codevibe-agent-plans"
				},
				{
					"command": "codevibe.plans.refresh",
					"group": "navigation@2",
					"when": "view == codevibe-agent-plans"
				}
			],
			"view/item/context": [
				{
					"command": "codevibe.plans.open",
					"group": "inline@1",
					"when": "view == codevibe-agent-plans && viewItem == codevibe.plan"
				},
				{
					"command": "codevibe.plans.buildLocal",
					"group": "inline@2",
					"when": "view == codevibe-agent-plans && viewItem == codevibe.plan"
				},
				{
					"command": "codevibe.plans.buildParallel",
					"group": "navigation@1",
					"when": "view == codevibe-agent-plans && viewItem == codevibe.plan"
				},
				{
					"command": "codevibe.plans.openFolder",
					"group": "navigation@2",
					"when": "view == codevibe-agent-plans"
				}
			],
			"chatSessions/newSession": [
				{
					"command": "codevibe.newNativeAgentSession",
					"group": "navigation@-1000"
				}
			],
			"editor/context": [
				{
					"command": "codevibe.addToChat",
					"group": "navigation",
					"when": "editorHasSelection"
				}
			],
			"terminal/context": [
				{
					"command": "codevibe.addTerminalOutputToChat",
					"group": "navigation"
				}
			],
			"scm/title": [
				{
					"command": "codevibe.generateGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && !codevibe.isGeneratingCommit"
				},
				{
					"command": "codevibe.abortGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && codevibe.isGeneratingCommit"
				}
			],
			"notebook/toolbar": [
				{
					"command": "codevibe.jupyterGenerateCell",
					"group": "navigation/add@1",
					"when": "notebookType == 'jupyter-notebook'"
				}
			],
			"notebook/cell/title": [
				{
					"command": "codevibe.jupyterExplainCell",
					"group": "inline@1",
					"when": "notebookType == 'jupyter-notebook'"
				},
				{
					"command": "codevibe.jupyterImproveCell",
					"group": "inline@2",
					"when": "notebookType == 'jupyter-notebook'"
				}
			],
			"commandPalette": [
				{
					"command": "codevibe.generateGitCommitMessage",
					"when": "config.git.enabled && !codevibe.isGeneratingCommit"
				},
				{
					"command": "codevibe.abortGitCommitMessage",
					"when": "config.git.enabled && codevibe.isGeneratingCommit"
				},
				{
					"command": "codevibe.openLegacyWebview",
					"when": "codevibe.isTestMode"
				},
				{
					"command": "codevibe.reviewComment.reply",
					"when": "false"
				}
			],
			"comments/commentThread/context": [
				{
					"command": "codevibe.reviewComment.reply",
					"group": "inline",
					"when": "commentController == codevibe-ai-review"
				}
			],
			"comments/commentThread/title": [
				{
					"command": "codevibe.reviewComment.addToChat",
					"group": "inline",
					"when": "commentController == codevibe-ai-review"
				}
			]
		},
		"configuration": {
			"title": "Codie",
			"properties": {
				"codevibe.openAiCodex.authSource": {
					"type": "string",
					"enum": [
						"codexHome",
						"vscodeSecret",
						"auto"
					],
					"enumItemLabels": [
						"Local Auth Files",
						"VS Code Secret",
						"Auto"
					],
					"default": "auto",
					"description": "Controls where Codie credentials are loaded from. Auto tries local auth files first, then IDE sign-in. Local auth files include workspace .codex/auth.json and ~/.codex/auth.json unless an explicit path or CODEX_HOME is set."
				},
				"codevibe.compatibility.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Enables Codie compatibility inputs such as canonical .codie/sandbox.json, Codie rules, ignore files, retrieval-indexing ignores, MCP configs, and legacy sandbox configs."
				},
				"codevibe.compatibility.deepLinks.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Enables validation for compatible deep-link route families before routing them into Codie tasks."
				},
				"codevibe.compatibility.retrievalIndexing.privacyGate": {
					"type": "boolean",
					"default": true,
					"description": "Requires compatible indexing and retrieval features to respect workspace ignore files and privacy gates."
				},
				"codevibe.compatibility.sandboxPolicy": {
					"type": "string",
					"enum": [
						"prompt",
						"workspace",
						"readOnly",
						"disabled"
					],
					"enumItemLabels": [
						"Prompt",
						"Workspace",
						"Read Only",
						"Disabled"
					],
					"default": "prompt",
					"description": "Default policy for untrusted sandbox inputs. Codie prefers .codie/sandbox.json and can fall back to a legacy sandbox config when no Codie sandbox config exists."
				},
				"codevibe.compatibility.safeBrowserEvaluate.enabled": {
					"type": "boolean",
					"default": false,
					"description": "Enables the same gated browser_action evaluate permission as Browser Settings > Allow browser JavaScript evaluation for compatible browser automation flows. Keep disabled unless you trust the active task."
				},
				"codevibe.cursorCompatibility.enabled": {
					"type": "boolean",
					"default": true,
					"deprecationMessage": "Use codevibe.compatibility.enabled.",
					"description": "Legacy alias for codevibe.compatibility.enabled."
				},
				"codevibe.cursorCompatibility.deepLinks.enabled": {
					"type": "boolean",
					"default": true,
					"deprecationMessage": "Use codevibe.compatibility.deepLinks.enabled.",
					"description": "Legacy alias for codevibe.compatibility.deepLinks.enabled."
				},
				"codevibe.cursorCompatibility.retrievalIndexing.privacyGate": {
					"type": "boolean",
					"default": true,
					"deprecationMessage": "Use codevibe.compatibility.retrievalIndexing.privacyGate.",
					"description": "Legacy alias for codevibe.compatibility.retrievalIndexing.privacyGate."
				},
				"codevibe.cursorCompatibility.sandboxPolicy": {
					"type": "string",
					"enum": [
						"prompt",
						"workspace",
						"readOnly",
						"disabled"
					],
					"enumItemLabels": [
						"Prompt",
						"Workspace",
						"Read Only",
						"Disabled"
					],
					"default": "prompt",
					"deprecationMessage": "Use codevibe.compatibility.sandboxPolicy.",
					"description": "Legacy alias for codevibe.compatibility.sandboxPolicy."
				},
				"codevibe.cursorCompatibility.safeBrowserEvaluate.enabled": {
					"type": "boolean",
					"default": false,
					"deprecationMessage": "Use codevibe.compatibility.safeBrowserEvaluate.enabled.",
					"description": "Legacy alias for codevibe.compatibility.safeBrowserEvaluate.enabled."
				},
				"codevibe.ui.preferOpenAiCodexSidebar": {
					"type": "boolean",
					"default": false,
					"description": "Opens the installed alternate agent sidebar instead of the native Codie Agent sidebar. Disabled by default so Codie stays the primary agent surface."
				},
				"ndjson.port": {
					"type": "number",
					"default": 0,
					"minimum": 0,
					"maximum": 65535,
					"description": "Port for the Codie compatibility NDJSON ingest server. Nonzero ports auto-start on activation; set to 0 to keep activation startup disabled while manual start still auto-allocates in range 7242-7942."
				},
				"ndjson.bindAddress": {
					"type": "string",
					"default": "127.0.0.1",
					"description": "Address to bind the Codie compatibility NDJSON ingest server to. Non-localhost addresses require confirmation because they can expose the ingest endpoint to the network."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "npm run check-types && npm run lint && node esbuild.mjs",
		"compile-standalone": "npm run check-types && npm run build:webview && npm run lint && node esbuild.mjs --standalone",
		"postcompile-standalone": "node scripts/package-standalone.mjs",
		"dev": "npm run protos && npm run watch",
		"watch": "npx npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.mjs --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"package": "npm run check-types && npm run build:webview && npm run lint && node esbuild.mjs --production",
		"protos": "node scripts/build-proto.mjs",
		"protos-python": "node scripts/build-python-proto.mjs",
		"download-ripgrep": "node scripts/download-ripgrep.mjs",
		"postprotos": "biome format --config-path ./biome.jsonc src/shared/proto src/generated webview-ui/src/services/grpc-client.ts --write --no-errors-on-unmatched",
		"clean:build": "rimraf dist dist-standalone webview-ui/build src/generated out/",
		"clean:deps": "rimraf node_modules webview-ui/node_modules",
		"clean:all": "npm run clean:build && npm run clean:deps",
		"compile-tests": "node ./scripts/build-tests.js",
		"watch-tests": "tsc -p . -w --outDir out",
		"check-types": "npm run protos && tsc --noEmit && cd webview-ui && tsc --noEmit",
		"lint": "biome lint --config-path ./biome.jsonc --no-errors-on-unmatched --files-ignore-unknown=true --diagnostic-level=error && npm run lint:proto",
		"lint:proto": "bash ./scripts/proto-lint.sh",
		"format": "biome format --config-path ./biome.jsonc --changed --since main --no-errors-on-unmatched --files-ignore-unknown=true --diagnostic-level=error",
		"format:fix": "biome check --config-path ./biome.jsonc --changed --since main --no-errors-on-unmatched --files-ignore-unknown=true --write",
		"fix:all": "biome check --config-path ./biome.jsonc --no-errors-on-unmatched --files-ignore-unknown=true --write --diagnostic-level=error --unsafe",
		"ci:check-all": "npx npm-run-all -p check-types lint format branding:audit compatibility:contracts",
		"ci:build": "npm run protos && npm run build:webview && node esbuild.mjs && npm run compile-tests",
		"pretest": "npm run compile && npm run compile-tests && npm run compile-standalone && npm run lint",
		"test": "npx npm-run-all test:unit test:integration",
		"test:integration": "vscode-test",
		"test:unit": "cross-env TS_NODE_PROJECT=./tsconfig.unit-test.json mocha",
		"test:coverage": "vscode-test --coverage",
		"test:sca-server": "npx tsx watch scripts/test-standalone-core-api-server.ts",
		"smoke:standalone-package": "node node_modules/tsx/dist/cli.mjs scripts/smoke-standalone-package.ts",
		"test:tp-orchestrator": "npx tsx scripts/testing-platform-orchestrator.ts",
		"e2e": "playwright test -c playwright.config.ts",
		"branding:audit": "node scripts/check-codevibe-branding.mjs",
		"compatibility:contracts": "node scripts/check-compatibility-contracts.mjs",
		"package:github-vsix:preflight": "node scripts/package-github-vsix.mjs --preflight",
		"release:preflight": "node scripts/package-github-vsix.mjs --preflight",
		"release:preflight:release": "node scripts/check-local-release-prereqs.mjs --release --github-release",
		"release:github-vsix": "node scripts/release-github-vsix.mjs",
		"release:cursor-parity:evidence": "node scripts/collect-cursor-parity-evidence.mjs",
		"release:cursor-parity:evidence:fast": "node scripts/collect-cursor-parity-evidence.mjs --run-retrieval-indexing --run-mcp-oauth --run-standalone-ui --run-sandbox-policy --run-deeplinks --run-ndjson --run-background-agents --run-browser-tools --run-mermaid-planning",
		"release:cursor-parity:evidence:retrieval": "node scripts/collect-cursor-parity-evidence.mjs --run-retrieval-indexing",
		"release:cursor-parity:evidence:mcp": "node scripts/collect-cursor-parity-evidence.mjs --run-mcp-oauth",
		"release:cursor-parity:evidence:standalone": "node scripts/collect-cursor-parity-evidence.mjs --run-standalone-ui",
		"release:cursor-parity:evidence:sandbox": "node scripts/collect-cursor-parity-evidence.mjs --run-sandbox-policy",
		"release:cursor-parity:evidence:deeplinks": "node scripts/collect-cursor-parity-evidence.mjs --run-deeplinks",
		"release:cursor-parity:evidence:ndjson": "node scripts/collect-cursor-parity-evidence.mjs --run-ndjson",
		"release:cursor-parity:evidence:background": "node scripts/collect-cursor-parity-evidence.mjs --run-background-agents",
		"release:cursor-parity:evidence:browser": "node scripts/collect-cursor-parity-evidence.mjs --run-browser-tools",
		"release:cursor-parity:evidence:mermaid": "node scripts/collect-cursor-parity-evidence.mjs --run-mermaid-planning",
		"release:cursor-parity:evidence:full": "node scripts/collect-cursor-parity-evidence.mjs --run-required",
		"release:standalone:assets": "node scripts/prepare-standalone-release-assets.mjs",
		"upstream:base:plan": "node scripts/prepare-upstream-base-patch.mjs",
		"upstream:base:fetch": "node scripts/prepare-upstream-base-patch.mjs --fetch --write-report",
		"upstream:base:export-patch": "node scripts/prepare-upstream-base-patch.mjs --export-patch --write-report",
		"package:github-vsix": "node scripts/package-github-vsix.mjs",
		"package:github-vsix:release": "node scripts/package-github-vsix.mjs --require-release-gate",
		"repair:vscode-state": "node scripts/package-github-vsix.mjs --clean-legacy-view-state-only",
		"test:e2e:build": "npm run ci:build && node scripts/package-github-vsix.mjs --out-file dist/e2e.vsix",
		"smoke:vsix:install": "node scripts/package-github-vsix.mjs --out-file dist/e2e.vsix --install",
		"smoke:github-vsix:install": "node scripts/package-github-vsix.mjs --install --verify-install",
		"test:e2e": "playwright install && npm run test:e2e:build && node src/test/e2e/utils/build.mjs && playwright test",
		"test:e2e:optimal": "npm run test:e2e:build && node src/test/e2e/utils/build.mjs && playwright test",
		"test:e2e:ui": "npx tsx scripts/interactive-playwright.ts",
		"install:all": "npm install && cd webview-ui && npm install",
		"dev:webview": "cd webview-ui && npm run dev",
		"build:webview": "cd webview-ui && npm run build",
		"test:webview": "cd webview-ui && npm run test",
		"publish:marketplace": "node scripts/publish-marketplace.mjs",
		"publish:marketplace:prerelease": "node scripts/publish-marketplace.mjs --pre-release",
		"publish:marketplace:nightly": "node ./scripts/publish-nightly.mjs",
		"branding:render-icon": "node scripts/render-codevibe-icon.mjs",
		"prepare": "npx husky",
		"docs": "cd docs && npm run dev",
		"docs:check-links": "cd docs && npm run check",
		"docs:rename-file": "cd docs && npm run rename",
		"report-issue": "node scripts/report-issue.js",
		"storybook": "cd webview-ui && npm run storybook",
		"eval:smoke:run": "npx tsx evals/smoke-tests/run-smoke-tests.ts"
	},
	"lint-staged": {
		"src/shared/storage/state-keys.ts": [
			"node scripts/generate-state-proto.mjs",
